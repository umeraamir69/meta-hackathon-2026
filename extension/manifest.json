{
  "manifest_version": 3,
  "name": "PR Diff Sentinel",
  "version": "0.5.2",
  "description": "Scan a GitHub PR or commit from this tab. On a repo home, tap one item to scan. Muse explains. Local dashboard included.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PR Diff Sentinel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://pr-diff-sentinel.vercel.app/*"
  ]
}
