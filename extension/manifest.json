{
  "manifest_version": 3,
  "name": "PR Diff Sentinel",
  "version": "0.3.0",
  "description": "One click scans the GitHub pull request in this tab. The gate fails if a secret is still in the diff or its commits.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PR Diff Sentinel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://github.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.vercel.app/*"
  ]
}
